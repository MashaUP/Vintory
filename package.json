{
  "name": "vintory",
  "version": "1.2.2",
  "private": true,
  "description": "Vintory — archivio personale degli annunci Vinted (estensione Manifest V3). Nessuna dipendenza a runtime: npm serve solo per test e pacchetto.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "test": "node scripts/check.mjs && eslint . && node --test tests/unit/*.test.mjs",
    "test:e2e": "python3 tests/e2e/run_all.py",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --github"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.5.0"
  },
  "license": "MIT"
}
